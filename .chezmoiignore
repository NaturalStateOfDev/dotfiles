# Repo-only files — never applied to $HOME.
README.md
CLAUDE.md
.gitignore
docs
docs/**
scripts
scripts/**

# Machine-local project registry for the chief-of-staff agent.
.claude/staff/projects.yaml

{{ if eq .chezmoi.os "windows" -}}
# zsh/oh-my-zsh/starship are Linux-side only.
.zshrc
.oh-my-zsh
.oh-my-zsh/**
.config/starship.toml
{{ else if contains "microsoft" (lower .chezmoi.kernel.osrelease) -}}
# WSL: WezTerm runs on the Windows host, which manages its own copy.
# Native Linux machines (no "microsoft" in the kernel release) DO get WezTerm.
.wezterm.lua
.config/wezterm
.config/wezterm/**
{{ end -}}
