{{ if hasPrefix "omarchy-" (dig "machine" "" .) -}}
#!/usr/bin/env bash
# Apps and defaults on top of a stock Omarchy install (desktop + laptop).
# Everything Omarchy itself ships (Hyprland, tmux, ghostty, shell bar, ...)
# is deliberately NOT here — a fresh install already provides it. This is
# only what was added by hand. Runs after apply, re-runs when this file
# changes. Idempotent: every step checks before acting.
set -u

info() { printf '\033[1;36m[apps]\033[0m %s\n' "$*"; }
command -v omarchy >/dev/null 2>&1 || { info "not an Omarchy machine — skipping"; exit 0; }

# --- packages ---------------------------------------------------------------
# omarchy pkg add is a plain `pacman -S --needed` — NO AUR fallback. One AUR
# name in the list makes pacman reject the whole batch, so repo and AUR
# packages are installed separately (AUR via yay, which is in Omarchy base).
aur_add() { yay -S --needed --noconfirm "$@" || info "AUR install failed for: $*"; }
COMMON=(firefox discord qbittorrent syncthing nfs-utils veracrypt)
omarchy pkg add "${COMMON[@]}" || info "some package installs failed — retry manually"
aur_add proton-pass-bin

{{ if eq .machine "omarchy-desktop" -}}
# Gaming stack (AMD dGPU). Steam/Lutris/Wine via umu; lug-helper for Star Citizen.
GAMING=(steam lutris gamescope umu-launcher wine-staging winetricks wine-gecko wine-mono
        lib32-vulkan-radeon)
omarchy pkg add "${GAMING[@]}" || info "some gaming packages failed — retry manually"
aur_add lug-helper

# Local LLM runtime (AMD GPU → rocm build, not cuda). Service stays disabled;
# start on demand with `systemctl start ollama`.
command -v ollama >/dev/null 2>&1 || omarchy pkg add ollama-rocm || info "ollama-rocm install failed"
{{ end -}}

# --- defaults ---------------------------------------------------------------
[ "$(omarchy-theme-current 2>/dev/null || omarchy theme current 2>/dev/null)" = "tokyo-night" ] ||
  omarchy-theme-set tokyo-night 2>/dev/null || info "theme set failed — run: omarchy theme set tokyo-night"

[ "$(omarchy-default-agent)" = "claude" ] || omarchy-default-agent claude

[ "$(omarchy-default-browser)" = "firefox" ] || omarchy-default-browser firefox

# mise-managed CLIs (chezmoi, gh, claude, codex, node) from ~/.config/mise/config.toml.
command -v mise >/dev/null 2>&1 && mise install --yes 2>/dev/null || info "run: mise install"

info "manual follow-ups: gh auth login · atuin login && atuin sync · copy ~/.ssh · Steam/Proton Pass sign-in"
{{ end -}}
